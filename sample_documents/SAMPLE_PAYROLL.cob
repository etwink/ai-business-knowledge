       IDENTIFICATION DIVISION.
       PROGRAM-ID. SAMPLE-COBOL-PROGRAM.
       
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EMPLOYEE-FILE ASSIGN TO "EMPLOYEE.DAT"
               ORGANIZATION IS SEQUENTIAL.
           SELECT OUTPUT-FILE ASSIGN TO "PAYROLL.OUT"
               ORGANIZATION IS SEQUENTIAL.
       
       DATA DIVISION.
       FILE SECTION.
       FD EMPLOYEE-FILE.
       01 EMPLOYEE-RECORD.
           05 EMP-ID PIC 9(5).
           05 EMP-NAME PIC X(30).
           05 EMP-SALARY PIC 9(7)V99.
           05 EMP-DEPT PIC X(20).
       
       FD OUTPUT-FILE.
       01 PAYROLL-RECORD.
           05 PAY-EMP-ID PIC 9(5).
           05 PAY-EMP-NAME PIC X(30).
           05 PAY-GROSS-SALARY PIC 9(7)V99.
           05 PAY-TAX-DEDUCTION PIC 9(7)V99.
           05 PAY-NET-SALARY PIC 9(7)V99.
       
       WORKING-STORAGE SECTION.
       01 WS-EOF-FLAG PIC X(1) VALUE 'N'.
       01 WS-TAX-RATE PIC 9V9(2) VALUE 0.15.
       01 WS-TOTAL-EMPLOYEES PIC 9(5) VALUE 0.
       01 WS-TOTAL-PAYROLL PIC 9(10)V99 VALUE 0.
       01 WS-NET-SALARY PIC 9(7)V99.
       
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           PERFORM OPEN-FILES.
           PERFORM READ-EMPLOYEE-RECORDS.
           PERFORM CLOSE-FILES.
           DISPLAY "PAYROLL PROCESSING COMPLETED SUCCESSFULLY".
           STOP RUN.
       
       OPEN-FILES.
           OPEN INPUT EMPLOYEE-FILE.
           OPEN OUTPUT OUTPUT-FILE.
       
       READ-EMPLOYEE-RECORDS.
           PERFORM UNTIL WS-EOF-FLAG = 'Y'
               READ EMPLOYEE-FILE
                   AT END
                       MOVE 'Y' TO WS-EOF-FLAG
                   NOT AT END
                       PERFORM CALCULATE-PAYROLL
                       PERFORM WRITE-PAYROLL-RECORD
                       ADD 1 TO WS-TOTAL-EMPLOYEES
               END-READ
           END-PERFORM.
       
       CALCULATE-PAYROLL.
           COMPUTE WS-NET-SALARY = 
               EMP-SALARY - (EMP-SALARY * WS-TAX-RATE).
           MOVE EMPLOYEE-RECORD TO PAYROLL-RECORD.
           MOVE EMP-SALARY TO PAY-GROSS-SALARY.
           COMPUTE PAY-TAX-DEDUCTION = 
               EMP-SALARY * WS-TAX-RATE.
           MOVE WS-NET-SALARY TO PAY-NET-SALARY.
           ADD PAY-NET-SALARY TO WS-TOTAL-PAYROLL.
       
       WRITE-PAYROLL-RECORD.
           WRITE PAYROLL-RECORD.
       
       CLOSE-FILES.
           CLOSE EMPLOYEE-FILE.
           CLOSE OUTPUT-FILE.
